# Copy to `.env` in this folder. Docker Compose loads it for the `frontend`
# service and it is git-ignored.
#
# Marked [compose] below: compose.yaml already sets this for local development
# and its value wins over this file, so setting it here only matters when you
# run the app outside Docker (`npm run dev`), or for a real deployment.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are visible to
# anyone using the site. Never put a secret behind that prefix.

NODE_ENV=development                       # [compose] development | production
# Base URL of kan-product-api, reached from the browser. Keep the trailing
# slash, which is how the existing axios client expects it.
NEXT_PUBLIC_API_URL=http://localhost:3010/ # [compose]
